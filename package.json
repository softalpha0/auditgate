{
  "name": "auditgate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && vitest run",
    "forge:lint": "pnpm build && pnpm --dir apps/forge exec forge lint",
    "forge:deploy": "pnpm build && pnpm --dir apps/forge exec forge deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
