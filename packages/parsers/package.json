{
  "name": "@auditgate/parsers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slither JSON, Aderyn JSON and Markdown audit reports to AuditGate findings. Pure TypeScript.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auditgate/core": "workspace:*"
  }
}
