{
  "name": "@auditgate/jira",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Findings to Jira issue fields, Markdown to ADF, and re-import merging. Pure TypeScript, no Forge imports.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auditgate/core": "workspace:*",
    "@auditgate/parsers": "workspace:*"
  }
}
